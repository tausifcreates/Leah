{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "leah-website",
	"compatibility_date": "2026-10-11",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Served only at leahapp.xyz; www.leahapp.xyz is redirected there by a zone
	// Redirect Rule.
	"routes": [{ "pattern": "leahapp.xyz", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true
}
