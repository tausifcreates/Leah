---
// From IINA's website (source/_header.slim); see LICENSE-IINA.
import { site, url } from "../site";
---

<div id="header">
  <nav class="navbar navbar-light navbar-expand-sm">
    <a class="navbar-brand" href={url("/")}>
      <img src={url("/images/logo.png")} alt="Home" />
      <span class="ml-2">Leah</span>
    </a>
    <button
      class="navbar-toggler"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
      data-target="#navbarSupportedContent"
      data-toggle="collapse"
      type="button"
    >
      <span class="fas fa-bars"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ml-auto">
        <li class="nav-item">
          <a class="nav-link" href="#"><span class="fas fa-cube"></span>Plugins</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="#" target="_blank"><span class="fas fa-globe-americas"></span>Translation</a>
        </li>
        <li class="nav-item">
          <a class="nav-link stressed left" href={site.appStoreUrl}><span class="fas fa-cloud-download-alt"></span>Downloads</a>
        </li>
        <li class="nav-item">
          <a class="nav-link stressed right" href="#"><span class="fab fa-github"></span>GitHub</a>
        </li>
      </ul>
    </div>
  </nav>
</div>
