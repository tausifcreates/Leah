---
// From IINA's website (source/_header.slim); see LICENSE-IINA.
import { faBars, faCommentDots, faFileVideo, faLifeRing, faList } from "@fortawesome/free-solid-svg-icons";
import { faApple } from "@fortawesome/free-brands-svg-icons";
import Icon from "./Icon.astro";
import { site, url } from "../site";
---

<div id="header">
  <nav class="navbar navbar-light navbar-expand-sm">
    <a class="navbar-brand" href={url("/")}>
      <img src={url("/images/logo.png")} width="192" height="179" alt="" />
      <span class="ml-2">Leah</span>
    </a>
    <button
      class="navbar-toggler"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
      type="button"
    >
      <Icon icon={faBars} />
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ml-auto">
        <li class="nav-item">
          <a class="nav-link" href={url("/features")}><Icon icon={faList} />Features</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={url("/support")}><Icon icon={faLifeRing} />Support</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={url("/formats")}><Icon icon={faFileVideo} />Formats</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={url("/faq")}><Icon icon={faCommentDots} />FAQ</a>
        </li>
        <li class="nav-item">
          <a class="nav-link stressed" href={site.appStoreUrl}><Icon icon={faApple} />Mac App Store</a>
        </li>
      </ul>
    </div>
  </nav>
</div>
