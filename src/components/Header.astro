---
// From IINA's website (source/_header.slim); see LICENSE-IINA.
import { site, url } from "../site";
---

<div id="header">
  <nav class="navbar navbar-light navbar-expand-sm">
    <a class="navbar-brand" href={url("/")}>
      <img src={url("/images/logo.png")} alt="" />
      <span class="ml-2">Leah</span>
    </a>
    <button
      class="navbar-toggler"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Toggle navigation"
      data-target="#navbarSupportedContent"
      data-toggle="collapse"
      type="button"
    >
      <span class="fas fa-bars"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav ml-auto">
        <li class="nav-item">
          <a class="nav-link" href={url("/features")}><span class="fas fa-list"></span>Features</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={url("/support")}><span class="fas fa-life-ring"></span>Support</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href={url("/privacy")}><span class="fas fa-lock"></span>Privacy</a>
        </li>
        <li class="nav-item">
          <a class="nav-link stressed" href={site.appStoreUrl}><span class="fab fa-apple"></span>Mac App Store</a>
        </li>
      </ul>
    </div>
  </nav>
</div>
