---
// The privacy policy and support page keep the look they had when this
// repository was published with GitHub Pages' Jekyll and its Primer theme:
// this is that site's _layouts/default.html, with the head tags Jekyll's
// SEO plugin added, and public/assets/css/style.css is the theme's
// stylesheet as it was published.
const { frontmatter, structuredData } = Astro.props;
const data = structuredData ?? frontmatter.structuredData;
const links = [
  ["Home", "/"],
  ["Features", "/features"],
  ["Formats", "/formats"],
  ["FAQ", "/faq"],
  ["Leah vs IINA", "/leah-vs-iina"],
  ["Leah vs VLC", "/leah-vs-vlc"],
  ["Support", "/support"],
  ["Privacy", "/privacy"],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteTitle = "Leah";
const description = frontmatter.description;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site);
const image = new URL(`${base}/images/og-image.jpg`, Astro.site).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | Leah, a Video Player for Mac</title>
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:locale" content="en_US" />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Leah playing a video on a Mac" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={frontmatter.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/png" href={`${base}/logo.png`} />
    {data && <script type="application/ld+json" set:html={JSON.stringify(data)} />}
    <link rel="stylesheet" href={`${base}/assets/css/style.css`} />
    <style is:inline>
      .site-title { font-size: 2em; font-weight: 600; line-height: 1.25; margin-bottom: 16px; padding-bottom: 0.3em; border-bottom: 1px solid #eaecef; }
      .site-title a { display: inline-flex; align-items: center; gap: 0.35em; }
      .site-title img { height: 1.3em; width: auto; }
      .page-links { margin-top: 3em; padding-top: 1em; border-top: 1px solid #eaecef; font-size: 0.9em; }
      .page-links a { margin-right: 1em; white-space: nowrap; }
    </style>
  </head>
  <body>
    <div class="container-lg px-3 my-5 markdown-body">
      <p class="site-title"><a href={`${base}/`}><img src={`${base}/logo.png`} width="144" height="134" alt="" />{siteTitle}</a></p>

      <slot />

      <nav class="page-links" aria-label="Leah pages">
        {links.map(([name, path]) => <a href={`${base}${path}`}>{name}</a>)}
        <a href="https://apps.apple.com/app/id6816698102">Mac App Store</a>
      </nav>
    </div>
  </body>
</html>
